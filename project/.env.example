# Supabase project URL (found in your Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server-side only — keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the application (used for auth redirects)
NEXT_PUBLIC_SITE_URL=
