# Supabase project URL — found in your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key — found in Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server-side only, never expose to client)
# Found in Supabase project Settings > API
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the deployed application (used for auth redirects and password reset links)
NEXT_PUBLIC_SITE_URL=
